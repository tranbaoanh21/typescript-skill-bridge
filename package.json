{
  "name": "hcmut-skillbridge",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript full-stack platform for student project discovery and collaboration.",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "db:explain": "npm run db:explain --workspace @skillbridge/database",
    "db:generate": "npm run db:generate --workspace @skillbridge/database",
    "db:migrate": "npm run db:migrate --workspace @skillbridge/database",
    "db:seed": "npm run db:seed --workspace @skillbridge/database",
    "db:studio": "npm run db:studio --workspace @skillbridge/database",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "npm run test:integration --workspace @skillbridge/database",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
