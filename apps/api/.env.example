NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://skillbridge:skillbridge@localhost:5433/skillbridge
DATABASE_POOL_MAX=10
REDIS_URL=redis://:skillbridge-redis@localhost:6379
CACHE_PROJECT_LIST_TTL_SECONDS=30
CACHE_PROJECT_DETAIL_TTL_SECONDS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=30
PRESENCE_TTL_SECONDS=30
ENABLE_API_DOCS=true
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_TOKEN_ISSUER=skillbridge-api
AUTH_TOKEN_AUDIENCE=skillbridge-clients
