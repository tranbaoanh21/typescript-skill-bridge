{
  "name": "@skillbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src tests scripts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "openapi:generate": "tsx scripts/export-openapi.ts",
    "postman:test": "tsx scripts/run-postman.ts",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'tests/**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage --exclude 'tests/**/*.integration.test.ts'",
    "test:integration": "vitest run tests/auth.integration.test.ts tests/domain.integration.test.ts tests/realtime.integration.test.ts tests/redis.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@skillbridge/contracts": "0.1.0",
    "@skillbridge/database": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/newman": "^5.3.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "newman": "^6.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
