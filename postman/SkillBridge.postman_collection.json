{
  "info": {
    "_postman_id": "2f398a8a-c82c-41d4-acd1-38bb3bdf507c",
    "name": "HCMUT SkillBridge API",
    "description": "Executable Phase 5 contract checks for health, API documentation, authentication, token rotation, reuse detection, and logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Readiness",
      "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('database is ready', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().dependencies.database).to.eql('ready');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI JSON",
      "request": { "method": "GET", "url": "{{baseUrl}}/docs/openapi.json" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('serves OpenAPI 3.1', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().openapi).to.eql('3.1.0');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Postman Contract\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates account and token pair', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.user.email).to.eql(pm.variables.get('testEmail'));",
              "  pm.expect(body.data.tokens.accessToken).to.be.a('string');",
              "  pm.expect(body.data.tokens.refreshToken).to.be.a('string');",
              "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
              "  pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate registration error",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Postman Contract\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns stable conflict error', () => {",
              "  pm.response.to.have.status(409);",
              "  const error = pm.response.json().error;",
              "  pm.expect(error.code).to.eql('AUTH_EMAIL_ALREADY_EXISTS');",
              "  pm.expect(error.requestId).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid login error",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rejects invalid credentials safely', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error.code).to.eql('AUTH_INVALID_CREDENTIALS');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates a login session', () => {",
              "  pm.response.to.have.status(200);",
              "  const tokens = pm.response.json().data.tokens;",
              "  pm.collectionVariables.set('accessToken', tokens.accessToken);",
              "  pm.collectionVariables.set('refreshToken', tokens.refreshToken);",
              "  pm.collectionVariables.set('originalRefreshToken', tokens.refreshToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "url": "{{baseUrl}}/api/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('accepts signed bearer token', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.user.email).to.eql(pm.variables.get('testEmail'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rotate refresh token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rotates refresh token', () => {",
              "  pm.response.to.have.status(200);",
              "  const replacement = pm.response.json().data.tokens.refreshToken;",
              "  pm.expect(replacement).not.to.eql(pm.collectionVariables.get('originalRefreshToken'));",
              "  pm.collectionVariables.set('refreshToken', replacement);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Detect refresh token reuse",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{originalRefreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('revokes token family on reuse', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error.code).to.eql('AUTH_REFRESH_TOKEN_REUSED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login for logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates session used by logout scenario', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('refreshToken', pm.response.json().data.tokens.refreshToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('revokes session', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "Rejected refresh after logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cannot refresh a logged-out session', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error.code).to.eql('AUTH_REFRESH_TOKEN_INVALID');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Skill catalog",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/skills" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('lists shared skills', () => {",
              "  pm.response.to.have.status(200);",
              "  const skill = pm.response.json().data.skills.find(item => item.slug === 'domain-integration');",
              "  pm.expect(skill).to.be.an('object');",
              "  pm.collectionVariables.set('skillId', skill.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Update profile skills",
      "request": {
        "method": "PUT",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skills\": [{ \"skillId\": \"{{skillId}}\", \"level\": 4 }]\n}"
        },
        "url": "{{baseUrl}}/api/v1/profile/skills"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('updates profile skills', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Core - Create project",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"capacity\": 3,\n  \"description\": \"Postman verifies the complete SkillBridge project workflow against PostgreSQL.\",\n  \"requiredSkills\": [{ \"skillId\": \"{{skillId}}\", \"desiredLevel\": 3, \"positions\": 1 }],\n  \"slug\": \"{{projectSlug}}\",\n  \"title\": \"Postman Core Project\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates owner project and membership', () => {",
              "  pm.response.to.have.status(201);",
              "  const project = pm.response.json().data.project;",
              "  pm.collectionVariables.set('projectId', project.id);",
              "  pm.collectionVariables.set('projectVersion', project.version);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Publish project",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"PUBLISH\",\n  \"version\": {{projectVersion}}\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/transitions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('publishes project', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.project.status).to.eql('RECRUITING'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Register applicant",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Postman Applicant\",\n  \"email\": \"{{applicantEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates applicant account', () => {",
              "  pm.response.to.have.status(201);",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('applicantAccessToken', data.tokens.accessToken);",
              "  pm.collectionVariables.set('applicantId', data.user.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Submit application",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{applicantAccessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"coverLetter\": \"I can contribute TypeScript and PostgreSQL experience to this project.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('submits pending application', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('applicationId', pm.response.json().data.application.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Accept application",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"ACCEPTED\",\n  \"note\": \"Accepted by executable Postman contract.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/decision"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('accepts application atomically', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.application.status).to.eql('ACCEPTED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Create sprint",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sprint 1\",\n  \"startsOn\": \"2026-09-01\",\n  \"endsOn\": \"2026-09-07\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/sprints"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates sprint', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('sprintId', pm.response.json().data.sprint.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Create assigned task",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Build project discovery page\",\n  \"priority\": \"HIGH\",\n  \"sprintId\": \"{{sprintId}}\",\n  \"assigneeIds\": [\"{{applicantId}}\"]\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('creates task for a project member', () => {",
              "  pm.response.to.have.status(201);",
              "  const task = pm.response.json().data.task;",
              "  pm.collectionVariables.set('taskId', task.id);",
              "  pm.collectionVariables.set('taskVersion', task.version);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Core - Update task as member",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{applicantAccessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"version\": {{taskVersion}}\n}"
        },
        "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('updates task with optimistic version', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.task.version).to.eql(2); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "applicantEmail", "value": "postman-applicant-local@example.com" },
    { "key": "projectSlug", "value": "postman-local-project" },
    { "key": "testEmail", "value": "postman-local@example.com" },
    { "key": "testPassword", "value": "correct-horse-battery-staple", "type": "secret" },
    { "key": "accessToken", "value": "", "type": "secret" },
    { "key": "refreshToken", "value": "", "type": "secret" },
    { "key": "originalRefreshToken", "value": "", "type": "secret" }
  ]
}
